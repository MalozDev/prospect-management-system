# MongoDB connection string
# For local MongoDB: mongodb://localhost:27017/prospect-management
# For MongoDB Atlas: mongodb+srv://<user>:<password>@<cluster>.mongodb.net/prospect-management
MONGODB_URI=mongodb+srv://user:password@cluster0.mongodb.net/prospect-management?retryWrites=true&w=majority

# JWT secret key for signing auth tokens
# Generate a strong secret: openssl rand -base64 32
JWT_SECRET=change-this-to-a-random-secret-in-production

# VAPID keys for Web Push notifications
# Generate with: npx web-push generate-vapid-keys
# These are required for push notifications to work.
# Set both keys for persistence across deployments:
VAPID_PUBLIC_KEY=<your-public-key>
VAPID_PRIVATE_KEY=<your-private-key>

# CUG phone prefix for WhatsApp notifications to DSEs
# This converts a DSE's 4-digit CUG suffix into a full phone number.
# Example: CUG "1234" + prefix "26096" → "+260961234" → opened in WhatsApp
# For Airtel Zambia this should be "26096" (country code 260 + carrier 96)
NEXT_PUBLIC_CUG_PHONE_PREFIX=26097898

# Secret key for triggering follow-up / visit-time reminders from an external
# cron job (e.g. cron-job.org) hitting POST /api/followups/reminders with the
# header "x-cron-secret: <value>".
# REQUIRED in production on serverless platforms (Vercel) where the built-in
# scheduler (instrumentation.ts) does not run — without a cron the reminders
# will never fire.
# Generate with: openssl rand -hex 32
CRON_SECRET=change-this-to-a-random-secret
